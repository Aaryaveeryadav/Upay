{
  "name": "upay",
  "version": "1.0.0",
  "private": true,
  "description": "Upaay — study app and admin portal for selected Classes 10–12",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "reset-admin": "node tools/reset-admin.js",
    "dev:web": "vite --config apps/web/vite.config.mjs",
    "build:web": "vite build --config apps/web/vite.config.mjs",
    "test:provider": "node tools/check/ai_provider.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "vite": "8.3.8"
  }
}
